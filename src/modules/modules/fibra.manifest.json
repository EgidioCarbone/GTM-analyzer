  "useCases": [
    {
      "id": "header-navigation",
      "label": "Header: navigazione cross-site",
      "description": "Verifica che le voci del menu superiore siano cliccabili e producano l'evento header_menu_click.",
      "trackingEvents": [
        "header_menu_click"
      ],
      "steps": [
        {
          "action": "click",
          "description": "Clicca sulla voce Hosting",
          "targetSelector": "#top-bar-header .left-list.site-list a[href*='hosting.aruba.it']",
          "expectEvents": [
            {
              "event": "header_menu_click",
              "payload": {
                "link_text": "Hosting",
                "link_url": "https://hosting.aruba.it/home.aspx",
                "index": "0"
              }
            }
          ],
          "expectUrlContains": "hosting.aruba.it"
        },
        {
          "action": "waitFor",
          "description": "Attendi il caricamento della pagina Hosting",
          "waitForSelector": "body"
        }
      ]
    },
    {
      "id": "main-navigation",
      "label": "Main navigation: voci principali",
      "description": "Verifica che le voci del menu principale siano cliccabili e generino l'evento header_menu_click.",
      "trackingEvents": [
        "header_menu_click"
      ],
      "steps": [
        {
          "action": "click",
          "description": "Clicca sulla voce Privati",
          "targetSelector": "#nav-privati-desktop",
          "expectEvents": [
            {
              "event": "header_menu_click",
              "payload": {
                "link_text": "Privati",
                "link_url": "/offerte-fibra-casa.aspx",
                "index": "1"
              }
            }
          ],
          "expectUrlContains": "offerte-fibra-casa"
        },
        {
          "action": "click",
          "description": "Torna alla home cliccando il logo",
          "targetSelector": "#logo-header a",
          "waitForSelector": "body"
        },
        {
          "action": "click",
          "description": "Apri il dropdown Aziende",
          "targetSelector": "#nav-aziende-desktop",
          "notes": "Richiede interazione per aprire il menu a tendina"
        },
        {
          "action": "click",
          "description": "Seleziona la voce P. IVA e aziende",
          "targetSelector": "#nav-piva-aziende-desktop",
          "expectEvents": [
            {
              "event": "header_menu_click",
              "payload": {
                "link_text": "P. IVA e aziende",
                "link_url": "/offerte-fibra-aziende.aspx",
                "index": "2"
              }
            }
          ],
          "expectUrlContains": "offerte-fibra-aziende"
        }
      ]
    }
    ,
    {
      "id": "view-item-list",
      "label": "Ecommerce: view_item_list",
      "description": "Verifica che la pagina generi l'evento view_item_list sul dataLayer dopo il caricamento della lista prodotti.",
      "trackingEvents": [
        "view_item_list"
      ],
      "steps": [
        {
          "action": "assertEvent",
          "description": "Attendi il push view_item_list sul dataLayer",
          "expectEvents": [
            {
              "event": "view_item_list"
            }
          ]
        }
      ]
    }
  ],
  "notes": "Manifest iniziale per il dominio Fibra: completare con ulteriori use case (lead form, CTA, ecc.)."
}
