          "navigation"
        ],
        "accentColor": "#6366f1",
        "icon": "ShieldCheck"
      },
      "supportedHosts": [
        "www.italgas.it"
      ],
      "defaultUrls": [
        "https://www.italgas.it/"
      ],
      "configFields": [],
      "defaultConfig": {}
    }
