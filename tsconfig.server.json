{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "express", "cors", "multer"],
    "allowImportingTsExtensions": true,
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "server-ssd.ts",
    "src/services/**/*.server.ts",
    "shared/**/*.ts"
  ]
}
